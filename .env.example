# Server-side Gemini configuration
GEMINI_API_KEY=your_google_ai_studio_key

# Optional override. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Supabase (required for auth + leads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# Admin only — do not use in pages or user API routes
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key

# Optional: used in auth email redirects (defaults to http://localhost:3000 in dev)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
